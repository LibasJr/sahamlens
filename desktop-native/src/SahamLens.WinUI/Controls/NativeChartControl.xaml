<UserControl
    x:Class="SahamLens.WinUI.Controls.NativeChartControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{ThemeResource CardBrush}" CornerRadius="12" Padding="14">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock x:Name="SymbolLabel" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="OhlcLabel" VerticalAlignment="Center" Opacity="0.75"/></StackPanel>
                <Button Grid.Column="1" Content="Indikator" Click="OnIndicatorClick" />
            </Grid>
            <StackPanel Grid.Row="1" x:Name="IndicatorPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" />
            <Canvas Grid.Row="2" x:Name="ChartCanvas" MinHeight="430" SizeChanged="OnCanvasSizeChanged" />
            <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                <Button Content="Start" Click="OnStart"/><Button Grid.Column="1" Content="Stop" Click="OnStop"/><Button Grid.Column="2" Content="Ulang" Click="OnRestart"/>
                <ComboBox Grid.Column="3" x:Name="Speed" SelectedIndex="1" Width="80"><ComboBoxItem Content="0.5×" Tag="0.5"/><ComboBoxItem Content="1×" Tag="1"/><ComboBoxItem Content="2×" Tag="2"/></ComboBox>
                <ProgressBar Grid.Column="4" x:Name="ReplayProgress" VerticalAlignment="Center" Minimum="0" Maximum="100" />
                <TextBlock Grid.Column="5" x:Name="ProgressLabel" VerticalAlignment="Center" Opacity="0.7" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
