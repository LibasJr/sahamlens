<Window
    x:Class="SahamLens.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SahamLens Native">
    <Grid Background="{ThemeResource AppSurfaceBrush}">
        <NavigationView x:Name="Navigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
                        PaneDisplayMode="Left" OpenPaneLength="245" SelectionChanged="OnNavigationChanged">
            <NavigationView.PaneHeader>
                <StackPanel Margin="8,12">
                    <TextBlock Text="SAHAMLENS" FontWeight="Bold" FontSize="20" />
                    <TextBlock Text="Native Research Terminal" Opacity="0.65" FontSize="11" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Pasar Hari Ini" Tag="Market"><NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Screener" Tag="Screener"><NavigationViewItem.Icon><SymbolIcon Symbol="Filter" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Analisis Emiten" Tag="Analysis"><NavigationViewItem.Icon><SymbolIcon Symbol="View" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Market Intelligence" Tag="Intelligence"><NavigationViewItem.Icon><SymbolIcon Symbol="World" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Riset Emiten" Tag="Research"><NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="AdminItem" Content="Admin Panel" Tag="Admin" Visibility="Collapsed"><NavigationViewItem.Icon><SymbolIcon Symbol="Permissions" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Padding="20,12" BorderBrush="#283131" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <AutoSuggestBox x:Name="TickerSearch" Width="280" PlaceholderText="Cari emiten (BBCA)" QuerySubmitted="OnTickerSubmitted" />
                        <Border Grid.Column="1" Margin="14,0" Padding="10,6" CornerRadius="12" Background="{ThemeResource CardBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="7"><Ellipse x:Name="ApiDot" Width="8" Height="8" Fill="#F59E0B"/><TextBlock x:Name="ApiStatus" Text="Memeriksa API"/></StackPanel>
                        </Border>
                        <Button Grid.Column="2" Content="Akun" Click="OnAccountClick" />
                    </Grid>
                </Border>
                <Grid Grid.Row="1">
                    <ScrollViewer>
                        <StackPanel x:Name="ContentHost" Padding="24" Spacing="16">
                            <TextBlock x:Name="WorkspaceKicker" Text="PASAR HARI INI" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}" />
                            <TextBlock x:Name="WorkspaceTitle" Text="Kondisi pasar dalam satu halaman" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock x:Name="WorkspaceDescription" MaxWidth="900" HorizontalAlignment="Left" TextWrapping="Wrap" Opacity="0.7" />
                            <CommandBar x:Name="ModuleBar" DefaultLabelPosition="Right" />
                            <InfoBar x:Name="StateBar" IsOpen="False" IsClosable="False" />
                            <ProgressRing x:Name="Loading" IsActive="False" Width="36" Height="36" HorizontalAlignment="Left" />
                            <ContentControl x:Name="NativeContent" />

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
