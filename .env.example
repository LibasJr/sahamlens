# SahamLens environment template
# Copy to .env.local for local development. Never commit real secrets.

# Core database/auth
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
JWT_SECRET_KEY=replace-with-long-random-secret
ADMIN_JWT_SECRET=replace-with-independent-long-random-secret
ADMIN_BREAK_GLASS_ENABLED=false
TRUSTED_PROXY_MODE=cloudflare
TRUSTED_APP_ORIGINS=https://sahamlens.id,https://www.sahamlens.id
AUTH_AUDIT_HASH_SECRET=replace-with-independent-hmac-secret
ADMIN_SECRET_KEY=replace-with-long-random-secret
INTERNAL_API_SECRET=replace-with-long-random-secret
CRON_SECRET=replace-with-long-random-secret

# Canonical application URL
APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# AI providers (configure at least the providers you intend to use)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
KIMI_API_KEY=
NVIDIA_API_KEY=

# 9Router - proxy OpenAI-compatible self-hosted yang merutekan ke banyak AI sekaligus.
# Isi KEDUANYA (base URL + API key) supaya aktif; kalau kosong, cascade AI jalan seperti
# biasa tanpa 9Router. Base URL boleh ditulis dengan atau tanpa akhiran /v1.
NINEROUTER_BASE_URL=
NINEROUTER_API_KEY=
# Kosong = "auto" (9Router yang memilih model). PERINGATAN: "auto" bisa memilih provider
# yang BELUM Anda pasang kredensialnya - hasilnya error "No active credentials for
# provider: X" walaupun router dan API key-nya sehat. Amannya isi eksplisit dengan model
# yang benar-benar ada di instance Anda (cek: GET {base}/v1/models). Urutan kiri-ke-kanan
# = urutan percobaan, mis:
# NINEROUTER_MODELS=nvidia/minimaxai/minimax-m3,nvidia/minimaxai/minimax-m2.7
NINEROUTER_MODELS=
# first (default) = 9Router dicoba sebelum provider langsung; last = jadi cadangan.
NINEROUTER_PRIORITY=first
# Lantai timeout per percobaan (ms). Default 15000 - router butuh waktu lebih karena
# melakukan fallback ke upstream-nya sendiri.
NINEROUTER_TIMEOUT_MS=15000
# Opsional: cheap | smart | mini (header X-Prompt-Budget ke 9Router).
NINEROUTER_PROMPT_BUDGET=

# Redis cache. Sejak 2026-08-13 memakai Redis biasa (di VPS production, atau lokal saat
# dev) - BUKAN Upstash REST lagi. UPSTASH_REDIS_REST_URL/TOKEN sudah tidak dibaca kode
# manapun. Kosong = semua cache degrade aman ke cache-miss, aplikasi tetap jalan.
REDIS_URL=redis://127.0.0.1:6379

# Upstash QStash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Ownership Flow (komposisi kepemilikan lokal/asing dari kustodian resmi)
# ---------------------------------------------------------------------------
# DUA GERBANG TERPISAH, dan pemisahannya disengaja:
#   OWNERSHIP_FLOW_ENABLED           -> modul terlihat (menu, API, panel admin)
#   OWNERSHIP_FLOW_INGESTION_ENABLED -> cron boleh MENULIS observasi ke database
#
# Keduanya default FALSE di kode (fail-closed): deployment yang belum menyetel
# apa pun tidak akan menyalakan fitur maupun menembak server sumber.
#
# PENTING: OWNERSHIP_FLOW_INGESTION_ENABLED=true SAJA TIDAK CUKUP. Ingestion
# juga menuntut sumbernya berstatus VERIFIED di
# modules/ownership-flow/source/source-registry.ts. Selama masih UNVERIFIED,
# cron berhenti di gerbang tanpa satu pun request keluar. Naikkan status itu
# HANYA setelah menjalankan `npm run audit:ksei-ownership` di VPS dan mengikuti
# checklist docs/ownership-flow/source-audit.md.
OWNERSHIP_FLOW_ENABLED=true
OWNERSHIP_FLOW_CRON_ENABLED=false
OWNERSHIP_FLOW_INGESTION_ENABLED=false
# Batas konkurensi ke sumber. JANGAN dinaikkan sembarangan - ini server publik
# milik lembaga, bukan API berbayar dengan kuota.
OWNERSHIP_FLOW_MAX_CONCURRENCY=3
OWNERSHIP_FLOW_TIMEOUT_MS=15000
OWNERSHIP_FLOW_MIN_DELAY_MS=250
# 0 = seluruh universe kanonik. Isi angka kecil saat uji coba.
OWNERSHIP_FLOW_UNIVERSE_LIMIT=0
# TTL cache presentasi. Freshness dihitung dari observed_date, BUKAN dari umur
# cache - jadi TTL ini tidak pernah membuat data basi terlihat segar.
OWNERSHIP_FLOW_CACHE_TTL_SEC=1800

# ---------------------------------------------------------------------------
# Automated EOD broker summary - NONAKTIF (server-only; never prefix NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# DINONAKTIFKAN 2026-08-14: ingestion menuntut upload sumber manual per emiten,
# yang tidak scalable untuk ratusan ticker. Variabel di bawah SENGAJA
# DIPERTAHANKAN (bukan dihapus) bersama kode, skema, dan seluruh data
# historisnya - fitur ini menunggu sumber broker summary yang legal, stabil,
# dan dapat diotomasi.
#
# Ownership Flow di atas BUKAN penggantinya: broker summary mengukur TRANSAKSI
# per kode broker, Ownership Flow mengukur KOMPOSISI KEPEMILIKAN. Lihat
# docs/ownership-flow/broker-vs-ownership.md.
BROKER_DATA_PROVIDER=indexalpha
INDEXALPHA_API_KEY=
# Free plan: 5 ticker/hari. Naikkan sesuai kuota paket Index Alpha Anda.
INDEXALPHA_DAILY_TICKER_LIMIT=5
# Nama lama tetap didukung untuk deployment yang sudah berjalan.
BROKER_DATA_API_KEY=
BROKER_DATA_API_BASE_URL=https://api.indexalpha.id

# SMTP / password reset
SMTP_EMAIL=
SMTP_PASSWORD=

# Telegram admin notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Search Console verification (optional)
GOOGLE_SITE_VERIFICATION=

# Payment display (public values; do not put private banking credentials here)
NEXT_PUBLIC_PAYMENT_BANK_NAME=
NEXT_PUBLIC_PAYMENT_BANK_ACCOUNT_NUMBER=
NEXT_PUBLIC_PAYMENT_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_PAYMENT_DANA_NUMBER=
NEXT_PUBLIC_PAYMENT_DANA_NAME=
NEXT_PUBLIC_PAYMENT_GOPAY_NUMBER=
NEXT_PUBLIC_PAYMENT_GOPAY_NAME=
# Privacy retention (hari). Job `npm run privacy:cleanup -- --confirm`.
PRIVACY_AUTH_EVENT_RETENTION_DAYS=90
PRIVACY_FUNNEL_RETENTION_DAYS=90
PRIVACY_LENSAI_FEEDBACK_RETENTION_DAYS=180
PRIVACY_UNPAID_ORDER_RETENTION_DAYS=180
PRIVACY_ADMIN_AUDIT_RETENTION_DAYS=365

# Entitlement rollout: false = guest/free harus mengikuti akses normal. NEXT_PUBLIC => build-time.
NEXT_PUBLIC_TESTING_OPEN_ACCESS=true

# ---------------------------------------------------------------------------
# Audit closure: rate limit compute publik + AI per akun
# ---------------------------------------------------------------------------
PUBLIC_COMPUTE_RATE_WINDOW_SEC=300
PUBLIC_COMPUTE_RATE_MAX=40
PUBLIC_COMPUTE_RATE_BLOCK_SEC=300
AI_ACCOUNT_RATE_WINDOW_SEC=3600
AI_ACCOUNT_RATE_MAX=30
AI_ACCOUNT_RATE_BLOCK_SEC=900
