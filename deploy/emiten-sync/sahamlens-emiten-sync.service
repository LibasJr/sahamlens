# /etc/systemd/system/sahamlens-emiten-sync.service
#
# Sinkronisasi katalog emiten (idx_emiten_900.csv) dengan daftar resmi BEI.
#
# KENAPA ADA. Katalog ini adalah daftar emiten aplikasi (loadEmitenList), calon universe
# backfill, dan dasar angka "cakupan emiten" di halaman /transparency. Sebelumnya berkasnya
# hanya snapshot manual - papan pencatatan bisa basi berbulan-bulan (temuan 24 Sep 2026:
# 18 papan salah, 129 nama terpotong 32 karakter).
#
# Job ini TIDAK menulis ke checkout produksi: ia bekerja di worktree terpisah, commit,
# push cabang, lalu membuka PR supaya perubahannya ditinjau dulu.
#
# PRASYARAT SERVER: python3 dengan curl_cffi (endpoint idx.co.id menolak klien tanpa
# fingerprint TLS browser) dan gh CLI sudah terautentikasi untuk user lens.

[Unit]
Description=SahamLens - sinkron katalog emiten dengan daftar resmi BEI (ajukan PR)
After=network-online.target
Wants=network-online.target
OnFailure=sahamlens-cron-alert@%n.service

[Service]
Type=oneshot
User=lens
Group=lens
WorkingDirectory=/opt/sahamlens/app
ExecStart=/usr/bin/bash /opt/sahamlens/app/scripts/emiten-sync-pr.sh

# Job menulis di worktree sendiri; batas waktu longgar karena unduhan BEI bisa lambat.
TimeoutStartSec=900

Nice=10