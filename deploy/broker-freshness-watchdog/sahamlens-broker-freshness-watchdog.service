[Unit]
Description=SahamLens - pengawas kesegaran data broker (market daily, broker per emiten, tumpukan CSV)
After=network-online.target sahamlens.service
Wants=network-online.target
# Kegagalan = data broker basi / CSV menumpuk tanpa diimpor -> pakai jalur peringatan cron.
OnFailure=sahamlens-cron-alert@%n.service

[Service]
Type=oneshot
User=lens
Group=lens
WorkingDirectory=/opt/sahamlens/app
EnvironmentFile=-/opt/sahamlens/app/.env.production
TimeoutStartSec=300
# Dijalankan dari checkout aplikasi (bukan /opt/sahamlens/scripts) supaya resolusi modul
# `pg` mengikuti lokasi node_modules aplikasi.
ExecStart=/usr/bin/node /opt/sahamlens/app/scripts/broker-freshness-watchdog.mjs

[Install]
WantedBy=multi-user.target