[Unit]
Description=SahamLens - warm cache LensScanner
After=network-online.target sahamlens.service
Wants=network-online.target

[Service]
Type=oneshot
User=lens
Group=lens
WorkingDirectory=/opt/sahamlens/app
EnvironmentFile=/opt/sahamlens/app/.env.production
TimeoutStartSec=10min
ExecStart=/usr/bin/curl --fail-with-body --silent --show-error --connect-timeout 15 --max-time 540 -H "Authorization: Bearer ${CRON_SECRET}" https://sahamlens.id/api/cron/screener-scan
NoNewPrivileges=true
