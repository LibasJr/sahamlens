[Unit]
Description=SahamLens - pengawas kebasian bukti input makro (BI-Rate, SBN, ERP, inflasi)
After=network-online.target sahamlens.service
Wants=network-online.target
# Kegagalan = bukti makro kritis sudah terlalu tua -> pakai jalur peringatan cron yang sudah ada.
OnFailure=sahamlens-cron-alert@%n.service

[Service]
Type=oneshot
User=lens
Group=lens
WorkingDirectory=/opt/sahamlens/app
EnvironmentFile=-/opt/sahamlens/app/.env.production
TimeoutStartSec=300
ExecStart=/usr/bin/node /opt/sahamlens/scripts/macro-evidence-watchdog.mjs