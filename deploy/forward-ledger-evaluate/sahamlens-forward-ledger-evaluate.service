[Unit]
Description=SahamLens - forward paper-trade signal ledger outcome evaluation
After=network-online.target sahamlens.service
Wants=network-online.target

[Service]
Type=oneshot
User=lens
Group=lens
WorkingDirectory=/opt/sahamlens/app
EnvironmentFile=/opt/sahamlens/app/.env.production
TimeoutStartSec=10min
ExecStart=/usr/bin/curl --fail-with-body --silent --show-error --connect-timeout 15 --max-time 540 -H "Authorization: Bearer ${CRON_SECRET}" http://127.0.0.1:3001/api/cron/forward-ledger-evaluate
NoNewPrivileges=true
