# Android (sahamlens-android) - path SDK lokal & cache Gradle, bukan bagian dari
# source yang perlu di-commit. Aturan khusus mobile/ (Expo) & android-webview/ dibuang
# 2026-08-11 bersama foldernya: keduanya digantikan sahamlens-android.
local.properties
.gradle/
.kotlin/
*/build/
*/*/build/

.vercel
scratch/

# Konfigurasi tool lokal (Claude Code) di root - bukan bagian dari aplikasi. Diberi
# awalan "/" supaya HANYA root yang di-ignore, bukan sahamlens-android/.claude/
# (error-learning log itu dokumentasi kerja Android yang sengaja tetap di-commit).
/.claude/
/.agents/
# Konfigurasi IDE JetBrains - lokal per mesin (masih menyebut nama proyek lama
# "trading" & path library mesin developer), tidak ada hubungannya dengan build.
/.idea/
/.antigravity/
/.artifacts/
/skills-lock.json
/.worktrees/
/.superpowers/
scripts/.backtest-universe-candidates.json

# Artefak build/dev lokal - regenerate otomatis, tidak perlu di-commit.
tsconfig.tsbuildinfo
.next-dev.log

# Data files berisi PII (email, password hash) & data transaksi user - jangan pernah
# ter-commit. File-file ini tetap dipakai di local dev (lib/dbLocal.ts / lib/supabase.ts
# shim menciptakannya otomatis kalau belum ada).
data/users.json
data/portfolios.json
data/transactions.json
data/council_cache.json
local_db.json
.env*
# Lindungi juga salah nama umum tanpa titik; Next.js tidak memuat file ini,
# tetapi isinya tetap dapat berupa secret dan tidak boleh ikut ter-commit.
/env.local
/env.local.*
scripts/.backtest-universe-stats.json
scripts/.universe-*-backfill-checkpoint.json

# Template env aman untuk onboarding developer; secret nyata tetap di-ignore.
!/.env.example

# Cache bytecode Python dari scripts/*.py
__pycache__/
*.pyc

# APK rilis native. Aplikasi Android punya repositori sendiri (lihat sahamlens-android);
# binari 60+ MB tidak boleh masuk repo web lagi - sekali masuk, ia ada di riwayat selamanya.
*.apk

# Playwright (harness responsif)
/test-results/
/playwright-report/

# Artefak harness responsif (dibuat ulang tiap `npm run test:responsive`)
/e2e/__screenshots__/
/e2e/__fixtures__/

# Artefak laporan keuangan XBRL dari BEI (scripts/sync-idx-financial-reports.py).
# Data runtime yang diregenerasi, dan besar: ~100KB per emiten-periode x ~850 emiten
# (~90MB per kuartal). Fixture untuk test disimpan terpisah & sengaja dipangkas di
# modules/fundamental/service/__tests__/fixtures/.
data/idx-financial/
