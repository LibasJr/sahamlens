{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "SahamLens desktop permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [{ "url": "https://sahamlens.id/**" }]
    }
  ]
}
